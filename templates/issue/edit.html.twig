{% extends 'base.html.twig' %}

{% block title %}Edit #{{ issue.id }}{% endblock %}

{% block stylesheets %}
    {% include 'issue/_form.css.twig' %}
{% endblock %}

{% block body %}
    {% include 'issue/_form.html.twig' with {
        heading: 'Edit issue #' ~ issue.id,
        submit_label: 'Save changes',
        back_url: path('issue_show', {id: issue.id}),
        back_label: 'Back to issue',
        cancel_url: path('issue_show', {id: issue.id})
    } %}
{% endblock %}

{% block javascripts %}
    {% include 'issue/_project_modal.js.twig' %}
{% endblock %}
