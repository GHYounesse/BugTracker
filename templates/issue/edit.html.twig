{% extends 'base.html.twig' %}

{% block title %}Edit #{{ issue.id }}{% endblock %}

{% block body %}
    <a href="{{ path('issue_show', {id: issue.id}) }}" class="back-link">&larr; Back to Issue</a>

    <div class="app-card detail-card styled-form" style="max-width: 720px;">
        <h1 style="font-size: 1.3rem; font-weight: 700; color: #f8fafc; margin-bottom: 20px;">Edit Issue #{{ issue.id }}</h1>

        {{ form_start(form) }}
            <div class="mb-3">{{ form_row(form.summary) }}</div>
            <div class="mb-3">{{ form_row(form.description) }}</div>

            <div class="form-row-3 mb-3">
                {% if form.status is defined %}<div>{{ form_row(form.status) }}</div>{% endif %}
                <div>{{ form_row(form.priority) }}</div>
                <div>{{ form_row(form.severity) }}</div>
            </div>

            <div class="form-row-2 mb-3">
                <div>{{ form_row(form.project) }}</div>
                <div>{{ form_row(form.category) }}</div>
            </div>

            <div class="form-row-2 mb-3">
                {% if form.assigned is defined %}<div>{{ form_row(form.assigned) }}</div>{% endif %}
                <div>{{ form_row(form.visibility) }}</div>
            </div>

            <div class="mb-3">{{ form_row(form.stepsToReproduce) }}</div>

            <div class="mb-3">
                {{ form_row(form.attachment) }}
                {% if issue.attachment %}
                    <div class="form-text">Current file: {{ issue.attachment }} (upload a new one to replace it)</div>
                {% endif %}
            </div>

            <button type="submit" class="btn-brand">Save Changes</button>
        {{ form_end(form) }}
    </div>
{% endblock %}
