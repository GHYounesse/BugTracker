{% extends 'base.html.twig' %}

{% block title %}#{{ issue.id }} - {{ issue.summary }}{% endblock %}

{% block stylesheets %}
    .issue-detail-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 16px;
        margin-bottom: 24px;
    }
    .issue-detail-header .issue-id {
        color: var(--muted);
        font-size: 0.85rem;
        font-weight: 600;
    }
    .issue-detail-header h1 {
        font-size: 1.7rem;
        line-height: 1.15;
        font-weight: 650;
        letter-spacing: -0.03em;
        color: var(--ink);
        margin: 4px 0 12px;
    }
    .tag-row {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
    }
    .issue-detail-grid {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 20px;
        align-items: start;
    }
    @media (max-width: 900px) {
        .issue-detail-grid { grid-template-columns: 1fr; }
    }
    .detail-card p {
        color: var(--soft);
        font-size: 0.95rem;
        line-height: 1.5;
        white-space: pre-line;
        margin: 0;
    }
    .detail-card .empty-note {
        color: var(--muted);
        font-size: 0.9rem;
    }
    .meta-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 9px 0;
        border-bottom: 1px solid var(--line-soft);
        font-size: 0.88rem;
    }
    .meta-row:last-child { border-bottom: none; }
    .meta-label { color: var(--muted); }
    .meta-value { color: var(--ink); font-weight: 500; }
    .comment {
        padding: 12px 0;
        border-bottom: 1px solid var(--line-soft);
    }
    .comment:last-of-type { border-bottom: none; }
    .comment-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 4px;
    }
    .comment-author { color: var(--ink); font-weight: 600; font-size: 0.88rem; }
    .comment-date { color: var(--muted); font-size: 0.78rem; }
    .comment-body { color: var(--soft); font-size: 0.92rem; white-space: pre-line; }
    .comment-textarea {
        width: 100%;
        background: var(--field-bg);
        border: 1px solid var(--line);
        border-radius: 10px;
        color: var(--ink);
        font-family: inherit;
        padding: 10px 12px;
        font-size: 0.95rem;
        resize: vertical;
    }
    .comment-textarea:hover { border-color: var(--muted); }
    .comment-textarea:focus {
        outline: none;
        border-color: var(--signal);
        box-shadow: 0 0 0 3px var(--ring);
    }
    .comment-errors {
        color: var(--danger);
        font-size: 0.8rem;
        list-style: none;
        padding: 0;
        margin: 6px 0 0;
    }
{% endblock %}

{% block body %}
    <a href="{{ path('app_home') }}" class="back-link">Back to dashboard</a>

    <div class="issue-detail-header">
        <div>
            <span class="issue-id">#{{ issue.id }}</span>
            <h1>{{ issue.summary }}</h1>
            <div class="tag-row">
                <span class="tag tag-{{ issue.status }}">{{ issue.status }}</span>
                <span class="tag tag-{{ issue.priority }}">{{ issue.priority }} priority</span>
                <span class="tag tag-{{ issue.severity }}">{{ issue.severity }} severity</span>
            </div>
        </div>
        <a href="{{ path('issue_edit', {id: issue.id}) }}" class="btn-brand">Edit issue</a>
    </div>

    <div class="issue-detail-grid">
        <div>
            <div class="app-card detail-card">
                <h2>Description</h2>
                <p>{{ issue.description }}</p>
            </div>

            {% if issue.stepsToReproduce %}
            <div class="app-card detail-card">
                <h2>Steps to Reproduce</h2>
                <p>{{ issue.stepsToReproduce }}</p>
            </div>
            {% endif %}

            {% if issue.attachment %}
            <div class="app-card detail-card">
                <h2>Attachment</h2>
                <a href="{{ asset('uploads/' ~ issue.attachment) }}" target="_blank" rel="noopener">{{ issue.attachment }}</a>
            </div>
            {% endif %}

            <div class="app-card detail-card">
                <h2>Comments ({{ issue.comments|length }})</h2>

                {% for comment in issue.comments %}
                <div class="comment">
                    <div class="comment-header">
                        <span class="comment-author">{{ comment.author.userIdentifier }}</span>
                        <span class="comment-date">{{ comment.createdAt|date('M j, Y H:i') }}</span>
                    </div>
                    <div class="comment-body">{{ comment.content }}</div>
                </div>
                {% else %}
                <p class="empty-note">No comments yet. Add the first one below.</p>
                {% endfor %}

                {{ form_start(commentForm, {action: path('issue_comment', {id: issue.id}), attr: {style: 'margin-top:16px;'}}) }}
                    {{ form_widget(commentForm.content, {attr: {class: 'comment-textarea'}}) }}
                    <ul class="comment-errors">{{ form_errors(commentForm.content) }}</ul>
                    <button type="submit" class="btn-brand" style="margin-top:8px;">Post Comment</button>
                {{ form_end(commentForm) }}
            </div>
        </div>

        <div>
            <div class="app-card detail-card">
                <h2>Details</h2>
                <div class="meta-row"><span class="meta-label">Project</span><span class="meta-value">{{ issue.project.name }}</span></div>
                <div class="meta-row"><span class="meta-label">Category</span><span class="meta-value">{{ issue.category.name }}</span></div>
                <div class="meta-row"><span class="meta-label">Reporter</span><span class="meta-value">{{ issue.reporter.userIdentifier }}</span></div>
                <div class="meta-row"><span class="meta-label">Assigned to</span><span class="meta-value">{{ issue.assigned ? issue.assigned.userIdentifier : 'Unassigned' }}</span></div>
                <div class="meta-row"><span class="meta-label">Visibility</span><span class="meta-value">{{ issue.visibility }}</span></div>
                <div class="meta-row"><span class="meta-label">Submitted</span><span class="meta-value">{{ issue.submittedAt|date('M j, Y H:i') }}</span></div>
                <div class="meta-row"><span class="meta-label">Updated</span><span class="meta-value">{{ issue.updatedAt|date('M j, Y H:i') }}</span></div>
            </div>
        </div>
    </div>
{% endblock %}
