<div class="issue-column">
    <div class="issue-column-header">
        <span class="stage-dot dot-{{ status }}" aria-hidden="true"></span>
        <span class="issue-column-title">{{ title }}</span>
        <span class="issue-count-badge">{{ page.count }}</span>
    </div>
    <div class="issue-column-body">
        {% for issue in issues %}
        {% set isOverdue = issue.dueDate and issue.dueDate < date() and issue.status != 'closed' %}
        <a class="issue-row{{ isOverdue ? ' issue-row-overdue' : '' }}" href="{{ path('issue_show', {id: issue.id}) }}">
            <div class="issue-row-top">
                <span class="issue-id">#{{ issue.id }}</span>
                <div class="issue-row-tags">
                    {% if isOverdue %}<span class="tag tag-overdue">Overdue</span>{% endif %}
                    <span class="tag tag-{{ issue.priority }}">{{ issue.priority }}</span>
                </div>
            </div>
            <div class="issue-summary">{{ issue.summary }}</div>
            <div class="issue-row-project">{{ issue.project.name }}</div>
            <div class="issue-row-assignee{{ issue.assigned ? '' : ' unassigned' }}">
                <span class="assignee-avatar">{{ issue.assigned ? issue.assigned.username|first|upper : '?' }}</span>
                {{ issue.assigned ? issue.assigned.username : 'Unassigned' }}
            </div>
            <div class="issue-row-bottom">
                <span class="tag tag-category">{{ issue.category.name }}</span>
                <span class="issue-date">{{ issue.submittedAt|date('M j, Y') }}</span>
            </div>
        </a>
        {% else %}
        <div class="issue-empty">No issues in this stage.</div>
        {% endfor %}
    </div>
    {% if page.total > 1 %}
    <div class="issue-column-pagination">
        <a href="{{ path('app_home', app.request.query.all|merge({('page_' ~ status): page.current - 1})) }}" class="{{ page.current <= 1 ? 'disabled' : '' }}">&larr; Prev</a>
        <span>Page {{ page.current }} of {{ page.total }}</span>
        <a href="{{ path('app_home', app.request.query.all|merge({('page_' ~ status): page.current + 1})) }}" class="{{ page.current >= page.total ? 'disabled' : '' }}">Next &rarr;</a>
    </div>
    {% endif %}
</div>
