{% extends 'base.html.twig' %}

{% block title %}Dashboard{% endblock %}

{% block stylesheets %}
    .dashboard-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 12px;
        margin-bottom: 24px;
    }
    .dashboard-header h1 {
        font-size: 1.5rem;
        font-weight: 700;
        margin: 0;
        color: #f8fafc;
    }
    .issue-board {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
    }
    @media (max-width: 900px) {
        .issue-board {
            grid-template-columns: repeat(2, 1fr);
        }
    }
    @media (max-width: 600px) {
        .issue-board {
            grid-template-columns: 1fr;
        }
    }
    .issue-column {
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 14px;
        overflow: hidden;
    }
    .issue-column-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 14px 18px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        font-weight: 600;
        color: #f1f5f9;
    }
    .issue-count-badge {
        background: rgba(255, 255, 255, 0.1);
        color: #cbd5e1;
        border-radius: 999px;
        padding: 2px 10px;
        font-size: 0.78rem;
        font-weight: 600;
    }
    .issue-column-body {
        padding: 10px;
        max-height: 480px;
        overflow-y: auto;
    }
    .issue-row {
        display: block;
        padding: 12px 14px;
        border-radius: 10px;
        margin-bottom: 8px;
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid rgba(255, 255, 255, 0.05);
        text-decoration: none;
        transition: background 0.12s ease, border-color 0.12s ease;
    }
    .issue-row:hover {
        background: rgba(255, 255, 255, 0.06);
        border-color: rgba(255, 255, 255, 0.12);
    }
    .issue-row-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 6px;
    }
    .issue-id {
        color: #64748b;
        font-size: 0.78rem;
        font-weight: 600;
    }
    .issue-summary {
        font-size: 0.92rem;
        color: #e2e8f0;
        margin-bottom: 8px;
    }
    .issue-row-project {
        font-size: 0.76rem;
        color: #a5b4fc;
        font-weight: 600;
        margin-bottom: 6px;
    }
    .issue-row-bottom {
        display: flex;
        align-items: center;
        justify-content: space-between;
        font-size: 0.78rem;
        color: #94a3b8;
    }
    .issue-empty {
        text-align: center;
        color: #64748b;
        font-size: 0.88rem;
        padding: 24px 12px;
    }
{% endblock %}

{% block body %}
    <div class="dashboard-header">
        <h1>Dashboard</h1>
        <a href="{{ path('app_issue') }}" class="btn-brand">+ New Issue</a>
    </div>

    <div class="issue-board">
        {% for status, issues in issuesByStatus %}
        {% include 'issue/_issue_list.html.twig' with {title: status|capitalize, issues: issues} %}
        {% endfor %}
    </div>
{% endblock %}
