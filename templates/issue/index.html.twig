{% extends 'base.html.twig' %}

{% block title %}Dashboard{% endblock %}

{% block stylesheets %}
    .dashboard-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 12px;
        margin-bottom: 24px;
    }
    .dashboard-header h1 {
        font-size: 1.5rem;
        font-weight: 700;
        margin: 0;
        color: #f8fafc;
    }
    .kpi-row {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 16px;
        margin-bottom: 20px;
    }
    @media (max-width: 600px) {
        .kpi-row {
            grid-template-columns: 1fr;
        }
    }
    .kpi-tile {
        padding: 16px 18px;
    }
    .kpi-value {
        font-size: 1.8rem;
        font-weight: 700;
        color: #f8fafc;
        line-height: 1;
    }
    .kpi-value.kpi-alert {
        color: #fca5a5;
    }
    .kpi-label {
        font-size: 0.8rem;
        color: #94a3b8;
        margin-top: 4px;
    }
    .issue-board {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
    }
    @media (max-width: 900px) {
        .issue-board {
            grid-template-columns: repeat(2, 1fr);
        }
    }
    @media (max-width: 600px) {
        .issue-board {
            grid-template-columns: 1fr;
        }
    }
    .issue-column {
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 14px;
        overflow: hidden;
    }
    .issue-column-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 14px 18px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        font-weight: 600;
        color: #f1f5f9;
    }
    .issue-count-badge {
        background: rgba(255, 255, 255, 0.1);
        color: #cbd5e1;
        border-radius: 999px;
        padding: 2px 10px;
        font-size: 0.78rem;
        font-weight: 600;
    }
    .issue-column-body {
        padding: 10px;
        max-height: 480px;
        overflow-y: auto;
    }
    .issue-column-pagination {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 14px;
        padding: 10px;
        border-top: 1px solid rgba(255, 255, 255, 0.08);
        font-size: 0.78rem;
        color: #94a3b8;
    }
    .issue-column-pagination a {
        color: #cbd5e1;
        text-decoration: none;
        padding: 2px 8px;
        border-radius: 6px;
    }
    .issue-column-pagination a:hover {
        background: rgba(255, 255, 255, 0.08);
    }
    .issue-column-pagination a.disabled {
        pointer-events: none;
        opacity: 0.3;
    }
    .issue-row {
        display: block;
        padding: 12px 14px;
        border-radius: 10px;
        margin-bottom: 8px;
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid rgba(255, 255, 255, 0.05);
        text-decoration: none;
        transition: background 0.12s ease, border-color 0.12s ease;
    }
    .issue-row:hover {
        background: rgba(255, 255, 255, 0.06);
        border-color: rgba(255, 255, 255, 0.12);
    }
    .issue-row-overdue {
        border-color: rgba(239, 68, 68, 0.35);
        background: rgba(239, 68, 68, 0.06);
    }
    .issue-row-overdue:hover {
        border-color: rgba(239, 68, 68, 0.5);
        background: rgba(239, 68, 68, 0.1);
    }
    .issue-row-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 6px;
    }
    .issue-row-tags {
        display: flex;
        align-items: center;
        gap: 6px;
    }
    .tag-overdue {
        background: rgba(239, 68, 68, 0.25);
        color: #fca5a5;
    }
    .issue-id {
        color: #64748b;
        font-size: 0.78rem;
        font-weight: 600;
    }
    .issue-summary {
        font-size: 0.92rem;
        color: #e2e8f0;
        margin-bottom: 8px;
    }
    .issue-row-project {
        font-size: 0.76rem;
        color: #a5b4fc;
        font-weight: 600;
        margin-bottom: 6px;
    }
    .issue-row-assignee {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 0.78rem;
        color: #cbd5e1;
        margin-bottom: 8px;
    }
    .issue-row-assignee.unassigned {
        color: #64748b;
        font-style: italic;
    }
    .assignee-avatar {
        width: 18px;
        height: 18px;
        border-radius: 50%;
        background: rgba(59, 130, 246, 0.25);
        color: #bfdbfe;
        font-size: 0.65rem;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }
    .issue-row-bottom {
        display: flex;
        align-items: center;
        justify-content: space-between;
        font-size: 0.78rem;
        color: #94a3b8;
    }
    .issue-empty {
        text-align: center;
        color: #64748b;
        font-size: 0.88rem;
        padding: 24px 12px;
    }
    .dashboard-filters {
        display: flex;
        align-items: center;
        gap: 14px;
        flex-wrap: wrap;
        margin-bottom: 20px;
    }
    .dashboard-filters select {
        width: auto;
        background: rgba(255, 255, 255, 0.06);
        border: 1px solid rgba(255, 255, 255, 0.1);
        color: #f1f5f9;
        border-radius: 8px;
        padding: 6px 10px;
        font-size: 0.85rem;
    }
    .dashboard-filters label {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 0.85rem;
        color: #cbd5e1;
        cursor: pointer;
    }
{% endblock %}

{% block body %}
    <div class="dashboard-header">
        <h1>Dashboard</h1>
        <a href="{{ path('app_issue') }}" class="btn-brand">+ New Issue</a>
    </div>

    <div class="kpi-row">
        <div class="app-card kpi-tile">
            <div class="kpi-value">{{ openCount }}</div>
            <div class="kpi-label">Open issues</div>
        </div>
        <div class="app-card kpi-tile">
            <div class="kpi-value{{ overdueCount > 0 ? ' kpi-alert' : '' }}">{{ overdueCount }}</div>
            <div class="kpi-label">Overdue</div>
        </div>
        <div class="app-card kpi-tile">
            <div class="kpi-value">{{ unassignedCount }}</div>
            <div class="kpi-label">Unassigned</div>
        </div>
    </div>

    <form method="get" action="{{ path('app_home') }}" class="dashboard-filters">
        <select name="project" class="form-select" onchange="this.form.submit()">
            <option value="">All projects</option>
            {% for project in availableProjects %}
            <option value="{{ project.id }}" {{ selectedProjectId == project.id ? 'selected' : '' }}>{{ project.name }}</option>
            {% endfor %}
        </select>
        <select name="category" class="form-select" onchange="this.form.submit()">
            <option value="">All categories</option>
            {% for category in availableCategories %}
            <option value="{{ category.id }}" {{ selectedCategoryId == category.id ? 'selected' : '' }}>{{ category.name }}</option>
            {% endfor %}
        </select>
        <select name="severity" class="form-select" onchange="this.form.submit()">
            <option value="">All severities</option>
            {% for severity in severities %}
            <option value="{{ severity }}" {{ selectedSeverity == severity ? 'selected' : '' }}>{{ severity|capitalize }}</option>
            {% endfor %}
        </select>
        <label>
            <input type="checkbox" name="mine" value="1" {{ onlyMine ? 'checked' : '' }} onchange="this.form.submit()">
            Assigned to me
        </label>
        <select name="sort" class="form-select" onchange="this.form.submit()">
            <option value="newest" {{ sort == 'newest' ? 'selected' : '' }}>Sort: Newest</option>
            <option value="priority" {{ sort == 'priority' ? 'selected' : '' }}>Sort: Priority</option>
            <option value="dueDate" {{ sort == 'dueDate' ? 'selected' : '' }}>Sort: Due date</option>
        </select>
    </form>

    <div class="issue-board">
        {% for status, issues in issuesByStatus %}
        {% include 'issue/_issue_list.html.twig' with {title: status|capitalize, issues: issues, status: status, page: pagination[status]} %}
        {% endfor %}
    </div>
{% endblock %}
