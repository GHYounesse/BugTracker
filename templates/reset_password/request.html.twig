<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Forgot password · BugTracker</title>
    <link rel="icon" type="image/png" href="{{ asset('images/logo.png') }}">
    {{ importmap('app') }}
    <style>
        {% include 'partials/_auth.css.twig' %}
    </style>
    {% include 'partials/_auth_theme_init.js.twig' %}
  </head>
  <body>
    <main class="auth-center">
      <div class="auth-card">
        <header class="brand">
          <img src="{{ asset('images/logo.png') }}" alt="">
          <span>BugTracker</span>
        </header>

        <h1>Forgot password?</h1>
        <p class="lede">Enter the email on your account and we'll send you a link to reset it.</p>

        {% for message in app.flashes('reset_password_error') %}
        <div class="alert-custom alert-danger" role="alert">{{ message }}</div>
        {% endfor %}

        {{ form_start(requestForm, {'attr': {'id': 'requestForm'}}) }}
          <div class="field-group">
            <label for="{{ requestForm.email.vars.id }}">Email</label>
            <div class="field">
              {{ form_widget(requestForm.email, {'attr': {'placeholder': 'you@example.com', 'autocomplete': 'email', 'autofocus': true}}) }}
            </div>
            <div class="field-errors">{{ form_errors(requestForm.email) }}</div>
          </div>

          <button class="btn-login" type="submit" id="requestSubmit">Send reset link</button>
        {{ form_end(requestForm) }}

        <p class="switch">Remembered it? <a href="{{ path('app_login') }}">Sign in</a></p>
      </div>
    </main>

    <button type="button" class="theme-toggle" id="themeToggle" aria-label="Toggle theme">
      <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path></svg>
      <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
    </button>

    {% include 'partials/_theme_toggle_script.js.twig' %}
    <script>
        document.getElementById('requestForm').addEventListener('submit', function () {
            var submit = document.getElementById('requestSubmit');
            submit.disabled = true;
            submit.textContent = 'Sending…';
        });
    </script>
  </body>
</html>
