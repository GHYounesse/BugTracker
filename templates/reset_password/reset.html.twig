<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Set a new password · BugTracker</title>
    <link rel="icon" type="image/png" href="{{ asset('images/logo.png') }}">
    {{ importmap('app') }}
    <style>
        {% include 'partials/_auth.css.twig' %}
    </style>
    {% include 'partials/_auth_theme_init.js.twig' %}
  </head>
  <body>
    <main class="auth-center">
      <div class="auth-card">
        <header class="brand">
          <img src="{{ asset('images/logo.png') }}" alt="">
          <span>BugTracker</span>
        </header>

        <h1>Set a new password</h1>
        <p class="lede">Choose a new password for your account.</p>

        {{ form_start(resetForm, {'attr': {'id': 'resetForm'}}) }}
          <div class="field-group">
            <label for="{{ resetForm.plainPassword.first.vars.id }}">New password</label>
            <div class="field">
              {{ form_widget(resetForm.plainPassword.first, {'attr': {'placeholder': 'At least 6 characters', 'autocomplete': 'new-password', 'autofocus': true}}) }}
              <button type="button" class="password-toggle" data-toggle-for="{{ resetForm.plainPassword.first.vars.id }}" aria-label="Show password">
                <svg class="icon-eye" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8Z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                <svg class="icon-eye-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17.94 17.94A10.94 10.94 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path><path d="M1 1l22 22"></path></svg>
              </button>
            </div>
            <div class="field-errors">{{ form_errors(resetForm.plainPassword.first) }}</div>
          </div>

          <div class="field-group">
            <label for="{{ resetForm.plainPassword.second.vars.id }}">Repeat new password</label>
            <div class="field">
              {{ form_widget(resetForm.plainPassword.second, {'attr': {'placeholder': 'Type it again', 'autocomplete': 'new-password'}}) }}
              <button type="button" class="password-toggle" data-toggle-for="{{ resetForm.plainPassword.second.vars.id }}" aria-label="Show password">
                <svg class="icon-eye" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8Z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                <svg class="icon-eye-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17.94 17.94A10.94 10.94 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path><path d="M1 1l22 22"></path></svg>
              </button>
            </div>
            <div class="field-errors">
              {{ form_errors(resetForm.plainPassword.second) }}
              {{ form_errors(resetForm.plainPassword) }}
            </div>
          </div>

          <button class="btn-login" type="submit" id="resetSubmit">Reset password</button>
        {{ form_end(resetForm) }}

        <p class="switch">Remembered it after all? <a href="{{ path('app_login') }}">Sign in</a></p>
      </div>
    </main>

    <button type="button" class="theme-toggle" id="themeToggle" aria-label="Toggle theme">
      <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path></svg>
      <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
    </button>

    {% include 'partials/_theme_toggle_script.js.twig' %}
    {% include 'partials/_password_toggle_script.js.twig' %}
    <script>
        document.getElementById('resetForm').addEventListener('submit', function () {
            var submit = document.getElementById('resetSubmit');
            submit.disabled = true;
            submit.textContent = 'Resetting…';
        });
    </script>
  </body>
</html>
