<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Create account · BugTracker</title>
    <link rel="icon" type="image/png" href="{{ asset('images/logo.png') }}">
    {{ importmap('app') }}
    <style>
        {% include 'partials/_auth.css.twig' %}

        /* ---------- layout: split form + product stage (same as login) ---------- */
        .auth {
            display: grid;
            grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
            min-height: 100vh;
        }
        .auth-form {
            display: flex;
            flex-direction: column;
            min-height: 100vh;
            padding: 28px clamp(24px, 6vw, 88px);
        }
        .form-body {
            width: 100%;
            max-width: 380px;
            margin-block: auto;
            padding-block: 32px;
        }
        h1 { margin-bottom: 24px; }
        .switch { text-align: left; }

        /* ---------- stage: a peek at the product ---------- */
        .stage {
            display: grid;
            place-items: center;
            margin: 16px 16px 16px 0;
            padding: clamp(28px, 4vw, 64px);
            overflow: hidden;
            border-radius: 28px;
            background: var(--stage-bg);
            color: var(--stage-ink);
        }
        .stage > * { grid-area: 1 / 1; }

        .stage-ring {
            width: min(118%, 820px);
            height: auto;
            color: var(--stage-ring);
        }
        .stage-copy {
            width: 100%;
            max-width: 31rem;
        }
        .stage-title {
            margin: 0 0 28px;
            max-width: 11ch;
            font-size: clamp(2.2rem, 3.6vw, 3.4rem);
            line-height: 1.02;
            font-weight: 600;
            letter-spacing: -0.04em;
        }

        .queue {
            display: grid;
            gap: 10px;
            margin: 0;
            padding: 0;
            list-style: none;
        }
        .issue {
            display: grid;
            grid-template-columns: auto auto minmax(0, 1fr) auto;
            align-items: center;
            gap: 12px;
            padding: 14px 16px;
            background: var(--stage-row);
            border: 1px solid var(--stage-line);
            border-radius: 12px;
            font-size: 0.92rem;
        }
        .issue .dot {
            width: 9px;
            height: 9px;
            border-radius: 50%;
        }
        .dot-urgent { background: #ff6b6b; }
        .dot-high { background: #f5a524; }
        .dot-normal { background: #6ea8ff; }
        .dot-low { background: #8b98b0; }
        .issue .key {
            color: var(--stage-muted);
            font-size: 0.82rem;
            font-weight: 500;
            font-variant-numeric: tabular-nums;
        }
        .issue .title {
            min-width: 0;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }
        .status { display: grid; justify-items: end; }
        .status > span {
            grid-area: 1 / 1;
            padding: 3px 10px;
            border-radius: 999px;
            font-size: 0.76rem;
            font-weight: 600;
        }
        .st-new { background: rgba(110, 168, 255, 0.16); color: #9cc2ff; }
        .st-confirmed { background: rgba(167, 139, 250, 0.2); color: #c4b5fd; }
        .st-accepted { background: rgba(59, 130, 246, 0.2); color: #93c5fd; }
        .st-assigned { background: rgba(34, 211, 238, 0.18); color: #67e8f9; }
        .st-closed { background: rgba(148, 163, 184, 0.18); color: #cbd5e1; }

        /* resting state = locked on. Motion below only plays for people who allow it. */
        .issue.is-target {
            outline: 2px solid var(--stage-lock);
            outline-offset: 5px;
        }
        .is-target .from { opacity: 0; }
        .is-target .to { opacity: 1; }

        @media (prefers-reduced-motion: no-preference) {
            .issue.is-target { animation: lock-on 0.85s 0.5s cubic-bezier(0.2, 0.8, 0.2, 1) both; }
            .is-target .from { animation: swap-out 0.3s 1.2s ease-in both; }
            .is-target .to { animation: swap-in 0.3s 1.2s ease-out both; }
        }
        @keyframes lock-on {
            from { outline-color: transparent; outline-offset: 28px; }
            to { outline-color: var(--stage-lock); outline-offset: 5px; }
        }
        @keyframes swap-out { from { opacity: 1; } to { opacity: 0; } }
        @keyframes swap-in { from { opacity: 0; } to { opacity: 1; } }

        /* ---------- small screens: the form is the page ---------- */
        @media (max-width: 900px) {
            .auth { grid-template-columns: minmax(0, 1fr); }
            .stage { display: none; }
            .auth-form { padding: 24px; }
            h1 { font-size: 1.85rem; }
        }
    </style>
    {% include 'partials/_auth_theme_init.js.twig' %}
  </head>
  <body>
    <main class="auth">
      <section class="auth-form">
        <header class="brand">
          <img src="{{ asset('images/logo.png') }}" alt="">
          <span>BugTracker</span>
        </header>

        <div class="form-body">
          <h1>Create account</h1>

          {% if app.user %}
          <div class="alert-custom alert-warning" role="status">
            You are signed in as {{ app.user.userIdentifier }}.
            <form method="post" action="{{ path('app_logout') }}">
              <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
              <button type="submit">Sign out</button>
            </form>
          </div>
          {% endif %}

          {{ form_start(registrationForm, {'attr': {'id': 'registerForm'}}) }}
            <div class="field-group">
              <label for="{{ registrationForm.username.vars.id }}">Username</label>
              <div class="field">
                {{ form_widget(registrationForm.username, {'attr': {'class': '', 'placeholder': 'Choose a username', 'autocomplete': 'username', 'autofocus': true}}) }}
              </div>
              <div class="field-errors">{{ form_errors(registrationForm.username) }}</div>
            </div>

            <div class="field-group">
              <label for="{{ registrationForm.email.vars.id }}">Email</label>
              <div class="field">
                {{ form_widget(registrationForm.email, {'attr': {'class': '', 'placeholder': 'you@example.com', 'autocomplete': 'email'}}) }}
              </div>
              <div class="field-errors">{{ form_errors(registrationForm.email) }}</div>
            </div>

            <div class="field-group">
              <label for="{{ registrationForm.plainPassword.first.vars.id }}">Password</label>
              <div class="field">
                {{ form_widget(registrationForm.plainPassword.first, {'attr': {'class': '', 'placeholder': 'At least 6 characters', 'autocomplete': 'new-password'}}) }}
                <button type="button" class="password-toggle" data-toggle-for="{{ registrationForm.plainPassword.first.vars.id }}" aria-label="Show password">
                  <svg class="icon-eye" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8Z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                  <svg class="icon-eye-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17.94 17.94A10.94 10.94 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path><path d="M1 1l22 22"></path></svg>
                </button>
              </div>
              <div class="field-errors">{{ form_errors(registrationForm.plainPassword.first) }}</div>
            </div>

            <div class="field-group">
              <label for="{{ registrationForm.plainPassword.second.vars.id }}">Repeat password</label>
              <div class="field">
                {{ form_widget(registrationForm.plainPassword.second, {'attr': {'class': '', 'placeholder': 'Type it again', 'autocomplete': 'new-password'}}) }}
                <button type="button" class="password-toggle" data-toggle-for="{{ registrationForm.plainPassword.second.vars.id }}" aria-label="Show password">
                  <svg class="icon-eye" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8Z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                  <svg class="icon-eye-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17.94 17.94A10.94 10.94 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path><path d="M1 1l22 22"></path></svg>
                </button>
              </div>
              <div class="field-errors">
                {{ form_errors(registrationForm.plainPassword.second) }}
                {{ form_errors(registrationForm.plainPassword) }}
              </div>
            </div>

            <div class="field-group">
              <div class="check">
                {{ form_widget(registrationForm.agreeTerms) }}
                <label for="{{ registrationForm.agreeTerms.vars.id }}">I agree to the terms</label>
              </div>
              <div class="field-errors">{{ form_errors(registrationForm.agreeTerms) }}</div>
            </div>

            <button class="btn-login" type="submit" id="registerSubmit">Create account</button>
          {{ form_end(registrationForm) }}

          <p class="switch">Already have an account? <a href="{{ path('app_login') }}">Sign in</a></p>
        </div>
      </section>

      <aside class="stage" aria-hidden="true">
        <svg class="stage-ring" viewBox="0 0 400 400" fill="none" stroke="currentColor" stroke-width="6" stroke-linecap="round">
          <path d="M335.84 166.13A140 140 0 0 0 233.87 64.16"></path>
          <path d="M166.13 64.16A140 140 0 0 0 64.16 166.13"></path>
          <path d="M64.16 233.87A140 140 0 0 0 166.13 335.84"></path>
          <path d="M233.87 335.84A140 140 0 0 0 335.84 233.87"></path>
          <path d="M200 30V70M330 200H370M200 330V370M30 200H70"></path>
        </svg>

        <div class="stage-copy">
          <h2 class="stage-title">Your team's bugs, in one queue.</h2>
          <ul class="queue">
            <li class="issue is-target">
              <span class="dot dot-urgent"></span>
              <span class="key">BUG-214</span>
              <span class="title">Checkout button ignores taps on iOS</span>
              <span class="status"><span class="from st-new">New</span><span class="to st-confirmed">Confirmed</span></span>
            </li>
            <li class="issue">
              <span class="dot dot-high"></span>
              <span class="key">BUG-209</span>
              <span class="title">Avatar upload fails above 5 MB</span>
              <span class="status"><span class="st-accepted">Accepted</span></span>
            </li>
            <li class="issue">
              <span class="dot dot-normal"></span>
              <span class="key">BUG-198</span>
              <span class="title">Chart labels unreadable in dark mode</span>
              <span class="status"><span class="st-assigned">Assigned</span></span>
            </li>
            <li class="issue">
              <span class="dot dot-low"></span>
              <span class="key">BUG-187</span>
              <span class="title">Due dates off by one across timezones</span>
              <span class="status"><span class="st-closed">Closed</span></span>
            </li>
          </ul>
        </div>
      </aside>
    </main>

    <button type="button" class="theme-toggle" id="themeToggle" aria-label="Toggle theme">
      <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path></svg>
      <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
    </button>

    {% include 'partials/_theme_toggle_script.js.twig' %}
    {% include 'partials/_password_toggle_script.js.twig' %}
    <script>
        document.getElementById('registerForm').addEventListener('submit', function () {
            var submit = document.getElementById('registerSubmit');
            submit.disabled = true;
            submit.textContent = 'Creating account…';
        });
    </script>
  </body>
</html>
