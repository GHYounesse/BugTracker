<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Register</title>
    {{ importmap('app') }}
    <style>
        :root {
            --brand: #6366f1;
            --brand-dark: #4f46e5;
        }
        body {
            min-height: 100vh;
            margin: 0;
            background: radial-gradient(circle at top, #1e2140 0%, #0f1123 65%, #0a0b18 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        }
        .login-card {
            width: 100%;
            max-width: 400px;
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 18px;
            padding: 40px 36px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.45);
            backdrop-filter: blur(6px);
        }
        .brand-badge {
            width: 56px;
            height: 56px;
            border-radius: 14px;
            background: linear-gradient(135deg, var(--brand), #a855f7);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.6rem;
            margin: 0 auto 16px;
            box-shadow: 0 8px 20px rgba(99, 102, 241, 0.35);
        }
        .brand-name {
            color: #f8fafc;
            font-weight: 700;
            font-size: 1.4rem;
            text-align: center;
            margin-bottom: 4px;
        }
        .brand-tagline {
            color: #94a3b8;
            text-align: center;
            font-size: 0.85rem;
            margin-bottom: 32px;
        }
        .field-label {
            color: #cbd5e1;
            font-size: 0.82rem;
            font-weight: 600;
            margin-bottom: 6px;
            display: block;
        }
        .input-icon-group {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 6px;
            padding: 0 14px;
            background: rgba(255, 255, 255, 0.06);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 10px;
            transition: border-color 0.15s ease, background 0.15s ease, box-shadow 0.15s ease;
        }
        .input-icon-group > svg {
            flex-shrink: 0;
            color: #94a3b8;
            opacity: 0.8;
        }
        .input-icon-group input {
            flex: 1 1 auto;
            min-width: 0;
            width: 100%;
            padding: 11px 0;
            background: transparent;
            border: none;
            color: #f1f5f9;
            font-size: 0.95rem;
        }
        .input-icon-group input:focus {
            outline: none;
        }
        .input-icon-group input::placeholder {
            color: #64748b;
        }
        .input-icon-group:focus-within {
            border-color: var(--brand);
            background: rgba(255, 255, 255, 0.09);
            box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.25);
        }
        .field-errors {
            color: #fca5a5;
            font-size: 0.8rem;
            list-style: none;
            padding: 0;
            margin: 0 0 16px;
        }
        .terms-row {
            display: flex;
            align-items: center;
            gap: 8px;
            margin: 18px 0;
        }
        .terms-row .form-check-input {
            width: 1.05em;
            height: 1.05em;
            background-color: rgba(255, 255, 255, 0.08);
            border-color: rgba(255, 255, 255, 0.25);
            cursor: pointer;
        }
        .terms-row .form-check-input:checked {
            background-color: var(--brand);
            border-color: var(--brand);
        }
        .terms-row label {
            color: #cbd5e1;
            font-size: 0.88rem;
            margin: 0;
            cursor: pointer;
        }
        .btn-login {
            width: 100%;
            padding: 12px;
            border: none;
            border-radius: 10px;
            background: linear-gradient(135deg, var(--brand), var(--brand-dark));
            color: #fff;
            font-weight: 600;
            font-size: 0.95rem;
            margin-top: 8px;
            transition: transform 0.12s ease, box-shadow 0.12s ease;
        }
        .btn-login:hover {
            transform: translateY(-1px);
            box-shadow: 0 8px 20px rgba(99, 102, 241, 0.4);
            color: #fff;
        }
        .register-link {
            display: block;
            text-align: center;
            margin-top: 20px;
            color: #94a3b8;
            font-size: 0.88rem;
        }
        .register-link a {
            color: #a5b4fc;
            font-weight: 600;
            text-decoration: none;
        }
        .register-link a:hover {
            text-decoration: underline;
        }
        .alert-custom {
            border-radius: 10px;
            font-size: 0.88rem;
            padding: 12px 14px;
            margin-bottom: 18px;
        }
    </style>
  </head>
  <body>

    <div class="login-card">
        {% if app.user %}
        <div class="alert alert-warning alert-custom">
            You are logged in as {{ app.user.userIdentifier }},
            <form method="post" action="{{ path('app_logout') }}" style="display:inline;">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
                <button type="submit" style="background:none;border:none;padding:0;color:inherit;text-decoration:underline;cursor:pointer;">Logout</button>
            </form>
        </div>
        {% endif %}

        <div class="brand-badge">🐞</div>
        <div class="brand-name">BugTracker</div>
        <div class="brand-tagline">Create your account</div>

        {{ form_start(registrationForm) }}
            <label class="field-label" for="{{ registrationForm.username.vars.id }}">Username</label>
            <div class="input-icon-group">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                {{ form_widget(registrationForm.username, {'attr': {'class': '', 'placeholder': 'Choose a username', 'autofocus': true}}) }}
            </div>
            <ul class="field-errors">{{ form_errors(registrationForm.username) }}</ul>

            <label class="field-label" for="{{ registrationForm.plainPassword.first.vars.id }}">Password</label>
            <div class="input-icon-group">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                {{ form_widget(registrationForm.plainPassword.first, {'attr': {'class': '', 'placeholder': 'Create a password'}}) }}
            </div>
            <ul class="field-errors">{{ form_errors(registrationForm.plainPassword.first) }}</ul>

            <label class="field-label" for="{{ registrationForm.plainPassword.second.vars.id }}">Repeat Password</label>
            <div class="input-icon-group">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                {{ form_widget(registrationForm.plainPassword.second, {'attr': {'class': '', 'placeholder': 'Repeat your password'}}) }}
            </div>
            <ul class="field-errors">
                {{ form_errors(registrationForm.plainPassword.second) }}
                {{ form_errors(registrationForm.plainPassword) }}
            </ul>

            <div class="terms-row">
                {{ form_widget(registrationForm.agreeTerms) }}
                <label for="{{ registrationForm.agreeTerms.vars.id }}">I agree to the terms</label>
            </div>
            <ul class="field-errors">{{ form_errors(registrationForm.agreeTerms) }}</ul>

            <button class="btn-login" type="submit">Create account</button>
        {{ form_end(registrationForm) }}

        <span class="register-link">Already have an account? <a href="{{ path('app_login') }}">Login</a></span>
    </div>

  </body>
</html>
