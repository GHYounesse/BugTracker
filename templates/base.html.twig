<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}BugTracker{% endblock %}</title>
        <link rel="icon" type="image/png" href="{{ asset('images/logo.png') }}">
        {% block importmap %}{{ importmap('app') }}{% endblock %}
        <style>
            :root {
                --brand: #3b82f6;
                --brand-dark: #2563eb;
            }
            body {
                min-height: 100vh;
                margin: 0;
                background: #0f1123;
                color: #e2e8f0;
                font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            }
            a {
                color: #93c5fd;
            }
            .navbar-brand-badge {
                width: 34px;
                height: 34px;
                border-radius: 9px;
                display: inline-block;
                object-fit: cover;
            }
            .app-navbar {
                background: rgba(255, 255, 255, 0.03);
                border-bottom: 1px solid rgba(255, 255, 255, 0.08);
            }
            .dropdown-menu {
                background: #151830;
                border: 1px solid rgba(255, 255, 255, 0.08);
            }
            .dropdown-item {
                color: #e2e8f0;
            }
            .dropdown-item:hover,
            .dropdown-item:focus {
                background: rgba(255, 255, 255, 0.08);
                color: #fff;
            }
            .dropdown-divider {
                border-color: rgba(255, 255, 255, 0.1);
            }
            .btn-brand {
                display: inline-block;
                padding: 9px 18px;
                border: none;
                border-radius: 10px;
                background: linear-gradient(135deg, var(--brand), var(--brand-dark));
                color: #fff;
                font-weight: 600;
                font-size: 0.9rem;
                text-decoration: none;
                transition: transform 0.12s ease, box-shadow 0.12s ease;
            }
            .btn-brand:hover {
                transform: translateY(-1px);
                box-shadow: 0 8px 20px rgba(59, 130, 246, 0.4);
                color: #fff;
            }
            .btn-outline-brand {
                display: inline-block;
                padding: 8px 16px;
                border: 1px solid rgba(255, 255, 255, 0.15);
                border-radius: 10px;
                background: rgba(255, 255, 255, 0.03);
                color: #e2e8f0;
                font-weight: 600;
                font-size: 0.88rem;
                text-decoration: none;
                transition: background 0.12s ease;
            }
            .btn-outline-brand:hover {
                background: rgba(255, 255, 255, 0.08);
                color: #fff;
            }
            .app-card {
                background: rgba(255, 255, 255, 0.04);
                border: 1px solid rgba(255, 255, 255, 0.08);
                border-radius: 14px;
            }
            .detail-card {
                padding: 20px;
                margin-bottom: 20px;
            }
            .detail-card h2 {
                font-size: 0.95rem;
                font-weight: 700;
                color: #f1f5f9;
                margin: 0 0 12px;
            }
            .tag {
                display: inline-block;
                text-transform: capitalize;
                font-size: 0.72rem;
                font-weight: 600;
                border-radius: 999px;
                padding: 3px 10px;
            }
            .tag-category {
                background: rgba(165, 180, 252, 0.15);
                color: #a5b4fc;
                text-transform: none;
            }
            /* priority & severity share the same escalating scale */
            .tag-low, .tag-trivial { background: rgba(148, 163, 184, 0.2); color: #cbd5e1; }
            .tag-normal, .tag-minor { background: rgba(99, 102, 241, 0.2); color: #a5b4fc; }
            .tag-high, .tag-major { background: rgba(245, 158, 11, 0.2); color: #fbbf24; }
            .tag-urgent, .tag-critical { background: rgba(239, 68, 68, 0.2); color: #fca5a5; }
            .tag-immediate, .tag-blocker { background: rgba(220, 38, 38, 0.35); color: #fecaca; }
            /* status has its own distinct palette - it's a workflow stage, not a severity level */
            .tag-new { background: rgba(99, 102, 241, 0.2); color: #a5b4fc; }
            .tag-confirmed { background: rgba(167, 139, 250, 0.2); color: #c4b5fd; }
            .tag-assigned { background: rgba(34, 211, 238, 0.2); color: #67e8f9; }
            .tag-accepted { background: rgba(59, 130, 246, 0.2); color: #93c5fd; }
            .tag-processed { background: rgba(34, 197, 94, 0.2); color: #86efac; }
            .tag-closed { background: rgba(148, 163, 184, 0.2); color: #cbd5e1; }
            .flash-message {
                border-radius: 10px;
                padding: 12px 16px;
                margin-bottom: 16px;
                font-size: 0.88rem;
            }
            .flash-success { background: rgba(34, 197, 94, 0.15); color: #86efac; border: 1px solid rgba(34, 197, 94, 0.25); }
            .flash-error { background: rgba(239, 68, 68, 0.15); color: #fca5a5; border: 1px solid rgba(239, 68, 68, 0.25); }
            .back-link {
                display: inline-block;
                margin-bottom: 16px;
                font-size: 0.88rem;
            }
            .styled-form .form-label {
                color: #cbd5e1;
                font-size: 0.82rem;
                font-weight: 600;
                margin-bottom: 6px;
            }
            .styled-form .form-control,
            .styled-form .form-select {
                background: rgba(255, 255, 255, 0.06);
                border: 1px solid rgba(255, 255, 255, 0.1);
                color: #f1f5f9;
                border-radius: 10px;
            }
            .styled-form .form-control:focus,
            .styled-form .form-select:focus {
                background: rgba(255, 255, 255, 0.09);
                border-color: var(--brand);
                box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.25);
                color: #f1f5f9;
            }
            .styled-form .form-select option {
                color: #0f1123;
            }
            .styled-form .form-text {
                color: #64748b;
            }
            .styled-form .invalid-feedback {
                color: #fca5a5;
                display: block;
            }
            /* the default (non-Bootstrap) form theme renders errors as a bare <ul> */
            .styled-form label + ul {
                color: #fca5a5;
                font-size: 0.8rem;
                margin: 4px 0 8px;
                padding-left: 18px;
            }
            .styled-form .required::after {
                content: " *";
                color: #64748b;
            }
            .form-row-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
            .form-row-3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 16px; }
            @media (max-width: 700px) {
                .form-row-2, .form-row-3 { grid-template-columns: 1fr; }
            }
            {% block stylesheets %}{% endblock %}
        </style>
    </head>
    <body>
        {% include 'partials/_navbar.html.twig' %}

        <main class="container-fluid" style="padding: 28px;">
            {% for type, messages in app.flashes %}
                {% for message in messages %}
                    <div class="flash-message flash-{{ type }}">{{ message }}</div>
                {% endfor %}
            {% endfor %}

            {% block body %}{% endblock %}
        </main>

        {% block javascripts %}{% endblock %}
    </body>
</html>
