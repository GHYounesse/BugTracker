{% extends 'base.html.twig' %}

{% block title %}Edit profile{% endblock %}

{% block body %}
    <a href="{{ path('user_show', {id: user.id}) }}" class="back-link">Back to profile</a>

    <div class="app-card detail-card styled-form" style="max-width: 560px; margin: 0 auto;">
        <h1 class="form-title">Edit profile</h1>

        {{ form_start(form) }}
            <div class="d-flex align-items-center gap-3 mb-3">
                {% include 'partials/_avatar.html.twig' with {user: user, size: 'lg'} %}
                <div class="flex-grow-1">
                    {{ form_row(form.avatar) }}
                </div>
            </div>
            {% if user.image %}
            <div class="mb-3">
                <label class="check" for="{{ form.removeAvatar.vars.id }}">
                    <input type="checkbox" id="{{ form.removeAvatar.vars.id }}" name="{{ form.removeAvatar.vars.full_name }}" value="1">
                    Remove current photo
                </label>
            </div>
            {% endif %}
            <div class="mb-3">{{ form_row(form.displayName) }}</div>
            <div class="mb-3">{{ form_row(form.email) }}</div>

            {# render_rest is off below so the photo checkbox isn't shown twice; the CSRF token must still be output #}
            {% if form._token is defined %}{{ form_widget(form._token) }}{% endif %}

            <button type="submit" class="btn-brand w-100">Save profile</button>
        {{ form_end(form, {render_rest: false}) }}
    </div>
{% endblock %}
