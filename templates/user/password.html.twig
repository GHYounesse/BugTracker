{% extends 'base.html.twig' %}

{% block title %}Change password{% endblock %}

{% block body %}
    <a href="{{ path('user_show', {id: app.user.id}) }}" class="back-link">Back to profile</a>

    <div class="app-card detail-card styled-form" style="max-width: 480px; margin: 0 auto;">
        <h1 class="form-title">Change password</h1>

        {{ form_start(form) }}
            <div class="mb-3">{{ form_row(form.currentPassword) }}</div>
            <div class="mb-3">{{ form_row(form.plainPassword.first) }}</div>
            <div class="mb-3">{{ form_row(form.plainPassword.second) }}</div>

            <p class="help-text mb-3" style="color: var(--muted); font-size: 0.85rem;">You will be signed out everywhere and asked to sign in with the new password.</p>

            <button type="submit" class="btn-brand w-100">Change password</button>
        {{ form_end(form) }}
    </div>
{% endblock %}
