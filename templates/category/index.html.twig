{% extends 'base.html.twig' %}

{% block title %}Categories{% endblock %}

{% block stylesheets %}
    .category-table {
        width: 100%;
        border-collapse: collapse;
    }
    .category-table th {
        text-align: left;
        font-size: 0.86rem;
        font-weight: 600;
        color: var(--muted);
        padding: 12px 18px;
        border-bottom: 1px solid var(--line);
    }
    .category-table td {
        padding: 14px 18px;
        border-bottom: 1px solid var(--line-soft);
        font-size: 0.95rem;
        vertical-align: middle;
    }
    .category-table tr:last-child td {
        border-bottom: none;
    }
    .category-actions {
        display: flex;
        gap: 8px;
        justify-content: flex-end;
    }
{% endblock %}

{% block body %}
    <div class="page-header">
        <h1>Categories</h1>
        <a href="{{ path('category_new') }}" class="btn-brand">New category</a>
    </div>

    <div class="app-card">
        {% if categories %}
        <table class="category-table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Issues</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {% for category in categories %}
                <tr>
                    <td>{{ category.name }}</td>
                    <td>{{ category.issues|length }}</td>
                    <td>
                        <div class="category-actions">
                            <a href="{{ path('category_edit', {id: category.id}) }}" class="btn-outline-brand">Edit</a>
                            <form method="post" action="{{ path('category_delete', {id: category.id}) }}" onsubmit="return confirm('Delete category &quot;{{ category.name }}&quot;?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete-category-' ~ category.id) }}">
                                <button type="submit" class="btn-outline-brand is-danger">Delete</button>
                            </form>
                        </div>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
        {% else %}
        <div class="empty-state">No categories yet. Create one to start organizing issues.</div>
        {% endif %}
    </div>
{% endblock %}
