{% extends 'base.html.twig' %}

{% block title %}Edit Category{% endblock %}

{% block body %}
    <a href="{{ path('category_index') }}" class="back-link">&larr; Back to Categories</a>

    <div class="app-card detail-card styled-form" style="max-width: 480px;">
        <h1 class="form-title">Edit Category</h1>

        {{ form_start(form) }}
            <div class="mb-3">{{ form_row(form.name) }}</div>
            <button type="submit" class="btn-brand">Save Changes</button>
        {{ form_end(form) }}
    </div>
{% endblock %}
