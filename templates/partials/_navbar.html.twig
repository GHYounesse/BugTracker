{% set current_route = app.request.attributes.get('_route') %}
<nav class="navbar navbar-expand-lg app-navbar">
  <div class="container-fluid px-4">
    <a class="navbar-brand d-flex align-items-center gap-2" href="{{ path('app_home') }}">
      <img class="navbar-brand-badge" src="{{ asset('images/logo.png') }}" alt="">
      BugTracker
    </a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="mainNav">
      {% if app.user %}
        <ul class="navbar-nav me-auto mb-2 mb-lg-0">
          <li class="nav-item">
            <a class="nav-link{{ current_route == 'app_home' ? ' active' : '' }}"{{ current_route == 'app_home' ? ' aria-current="page"' : '' }} href="{{ path('app_home') }}">Dashboard</a>
          </li>
          <li class="nav-item">
            <a class="nav-link{{ current_route == 'app_issue' ? ' active' : '' }}"{{ current_route == 'app_issue' ? ' aria-current="page"' : '' }} href="{{ path('app_issue') }}">New Issue</a>
          </li>
          <li class="nav-item">
            <a class="nav-link{{ current_route starts with 'category_' ? ' active' : '' }}" href="{{ path('category_index') }}">Categories</a>
          </li>
          <li class="nav-item">
            <a class="nav-link{{ current_route starts with 'project_' ? ' active' : '' }}" href="{{ path('project_index') }}">Projects</a>
          </li>
          {% if is_granted('ROLE_ADMIN') %}
          <li class="nav-item">
            <a class="nav-link{{ current_route == 'list' ? ' active' : '' }}" href="{{ path('list') }}">Users</a>
          </li>
          {% endif %}
        </ul>
        <ul class="navbar-nav ms-auto mb-2 mb-lg-0 align-items-lg-center gap-lg-2">
          <li class="nav-item">
            {% include 'partials/_theme_toggle.html.twig' %}
          </li>
          <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle d-flex align-items-center gap-2" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
              {% include 'partials/_avatar.html.twig' with {user: app.user, size: 'sm'} %}
              {{ app.user.displayName ?: app.user.userIdentifier }}
            </a>
            <ul class="dropdown-menu dropdown-menu-end">
              <li><a class="dropdown-item" href="{{ path('user_show', {id: app.user.id}) }}">My profile</a></li>
              <li><a class="dropdown-item" href="{{ path('user_password') }}">Change password</a></li>
              <li><hr class="dropdown-divider"></li>
              <li>
                <form method="post" action="{{ path('app_logout') }}">
                  <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
                  <button type="submit" class="dropdown-item">Logout</button>
                </form>
              </li>
            </ul>
          </li>
        </ul>
      {% else %}
        <ul class="navbar-nav ms-auto mb-2 mb-lg-0 align-items-lg-center gap-lg-2">
          <li class="nav-item">
            {% include 'partials/_theme_toggle.html.twig' %}
          </li>
          <li class="nav-item"><a class="nav-link" href="{{ path('app_login') }}">Login</a></li>
          <li class="nav-item"><a class="nav-link" href="{{ path('app_register') }}">Register</a></li>
        </ul>
      {% endif %}
    </div>
  </div>
</nav>
