    .error-page {
        max-width: 460px;
        margin: 10vh auto 0;
        padding: 0 16px;
        text-align: center;
    }
    .error-code {
        display: inline-block;
        margin-bottom: 16px;
        color: var(--muted);
        font-size: 0.9rem;
        font-weight: 600;
        font-variant-numeric: tabular-nums;
    }
    .error-page h1 {
        margin: 0 0 12px;
        font-size: 1.7rem;
        line-height: 1.2;
        font-weight: 650;
        letter-spacing: -0.03em;
    }
    .error-page p {
        margin: 0 0 28px;
        color: var(--muted);
        font-size: 0.98rem;
        line-height: 1.55;
    }
